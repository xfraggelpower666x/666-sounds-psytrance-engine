{
  "name": "666-sounds-psytrance-engine",
  "version": "1.0.0",
  "description": "666 SOUNDS DESIGN — Psychoacoustic Psytrance Prompt Engine",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:html",
    "lint:js": "eslint app.js psycho.js engine4d.js matrix.js sw.js",
    "lint:html": "html-validate index.html",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:psycho": "jest tests/psycho.test.js --verbose",
    "test:4d": "jest tests/engine4d.test.js --verbose",
    "test:production": "jest tests/production.test.js --verbose"
  },
  "keywords": [
    "psytrance",
    "suno",
    "pwa",
    "prompt-generator"
  ],
  "author": "666 SOUNDS DESIGN",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.0",
    "html-validate": "^8.0.0",
    "jest": "^29.7.0"
  },
  "keywords": ["psytrance", "suno", "pwa", "prompt-generator"],
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
